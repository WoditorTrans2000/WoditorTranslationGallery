227 DIALOGEX 0, 0, 489, 232
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Para os usuários do WOLF RPG Editor antes da Versão 2: Convertam os arquivos primeiro."
LANGUAGE LANG_JAPANESE, 0x1
FONT 9, "MS Shell Dlg"
{
   CONTROL 127, -1, STATIC, SS_ICON | WS_CHILD | WS_VISIBLE, 7, 30, 20, 20 
   CONTROL "  Bem vindo ao WOLF RPG Editor 3!\r\nComo a codificação dos caracteres de todos os dados foram mudados para \"UTF-8\", será necessários converter os arquivos para essa codificação. Está pronto?\r\n\r\n[Arquivos para serem convertidos]\r\n- Dados Básicos (.dat/.project) na pastas Data/BasicData \r\n- Todos os arquivos de mapas (.mps) na pasta Data\r\n- Todos arquivos de textos (.txt) na pasta de Data\r\n- Todos arquivos CSV (.csv) na pasta de Data", -1, STATIC, SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 36, 4, 228, 84 , WS_EX_STATICEDGE
   CONTROL "[Conversão de dados]\nExecute", 1, BUTTON, BS_DEFPUSHBUTTON | BS_MULTILINE | WS_CHILD | WS_VISIBLE | WS_GROUP | WS_TABSTOP, 55, 156, 86, 31 
   CONTROL "", 1893, EDIT, ES_LEFT | ES_MULTILINE | ES_READONLY | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_VSCROLL | WS_TABSTOP, 273, 24, 210, 194 
   CONTROL "[Importante]\nOs arquivos convertidos serão copiados (salvado) na pasta \"Backup_Before_Ver3\".\nSe um problema ocorrer, por favor reverta para esses arquivos..", -1, STATIC, SS_CENTER | WS_CHILD | WS_VISIBLE | WS_GROUP, 12, 195, 241, 36 
   CONTROL "Cancelar\r\n(Encerra o Editor)", 2, BUTTON, BS_DEFPUSHBUTTON | BS_MULTILINE | WS_CHILD | WS_VISIBLE | WS_GROUP | WS_TABSTOP, 167, 159, 56, 25 
   CONTROL "[Log de conversão]\r\nSão salvo no Backup_Before_Ver3/ConvertLog.txt", -1, STATIC, SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 267, 5, 218, 18 
   CONTROL "[Conversão de arquivos de textos]\r\n Outros arquivos de textos que não são .txt no Data (Por exemplo: .log) não irão ser convertido. Por favor converta a codificação do caracteres em UTF-8 dos arquivos depois.\r\n Arquivos de textos com codificação de caracteres UTF-8 não serão convertido, mas arquivos não UTF-8 podem ser convertido mesmo em idiomas diferentes.", -1, STATIC, SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 19, 90, 245, 59 , WS_EX_STATICEDGE
   CONTROL "[Reiniciar!]", 3, BUTTON, BS_DEFPUSHBUTTON | BS_MULTILINE | WS_CHILD | WS_GROUP | WS_TABSTOP, 47, 158, 114, 26 
   CONTROL "Abre uma lista de tarefas\r\n(TaskList.txt)", 4, BUTTON, BS_DEFPUSHBUTTON | BS_MULTILINE | WS_CHILD | WS_GROUP | WS_TABSTOP, 173, 160, 88, 25 
