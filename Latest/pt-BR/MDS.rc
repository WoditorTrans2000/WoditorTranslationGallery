   CONTROL "Arquivos de fontes (ttf,ttc) devem ser colocado junto com Game.exe (Eles não podem ser carregados no dados)", -1, STATIC, SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 22, 114, 195, 19 , WS_EX_STATICEDGE
